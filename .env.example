# Provider API keys (copy to .env and fill in; NEVER commit real keys).
#
# Each key enables a Target provider. The lab reads them at runtime and
# scrubs their values from generated reports.

# OpenAI-compatible (https://platform.openai.com)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ollama — usually no key needed for local. Set when served behind a proxy.
OLLAMA_API_KEY=

# Optionally point the Ollama/OpenAI-compatible client at a different host
# (e.g. the in-network `ollama` service when using Docker Compose).
OLLAMA_HOST=http://localhost:11434
#OPENAI_BASE_URL=http://localhost:11434/v1